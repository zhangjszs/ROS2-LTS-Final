<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>track_benchmark</name>
  <version>1.0.0</version>
  <description>C++20 Track Generator and KPI Benchmark Evaluator for FSAC Autonomous Racing</description>
  <maintainer email="kerwin@todo.todo">kerwin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>common_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>vehicle_simulator</depend>
  <!-- #19 B1：benchmark_runner 链 MPC 数学核 (mpc_controller_lib) -->
  <depend>mpc_controller</depend>
  <!-- #36：benchmark_runner 第三口径复用 velocity_profiler_lib（与 track_benchmark 已依赖 mpc_controller_lib 同先例） -->
  <depend>velocity_profiler</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
